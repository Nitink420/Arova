# ===== AROVA Configuration =====
# Copy this file to .env and adjust values for your environment.

# Environment: desktop | jetson
ENVIRONMENT=desktop

# Device: auto | cuda | cpu (auto detects CUDA availability)
DEVICE=auto

# Feature toggles
ENABLE_OLLAMA=true
ENABLE_STT=true
ENABLE_TTS=true
ENABLE_MULTILINGUAL=true

# Multilingual Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,bn,ta,te,gu,mr,kn,ml,pa,ur
AUTO_DETECT_LANGUAGE=false

# LLM backend: ollama (offline, default) | gemini (Gemma 4 via Gemini API, online)
# If the Gemini call fails, AROVA falls back to Ollama, then to the rule engine.
LLM_BACKEND=ollama

# Gemini API (only used when LLM_BACKEND=gemini). Keep the key ONLY in .env.
ENABLE_GEMINI=true
GEMINI_API_KEY=
# gemma-4-31b-it (default) | gemma-4-26b-a4b-it
GEMINI_MODEL=gemma-4-31b-it
GEMINI_TIMEOUT=30

# Ollama LLM API configuration
# Desktop: http://127.0.0.1:11434
# AIProff Jetson: http://172.xx.xx.xx:11434
OLLAMA_API_URL=http://127.0.0.1:11434
# Offline models that can be switched at runtime (pull each: ollama pull <model>)
OLLAMA_MODELS=gemma3:1b,llama3.2:1b
# Active offline model (must be one of OLLAMA_MODELS)
OLLAMA_MODEL=gemma3:1b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=1
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.8
OLLAMA_NUM_PREDICT=200
OLLAMA_NUM_THREAD=8
OLLAMA_TIMEOUT=30

# Vision model path (relative to project root)
MODEL_PATH=models/vision/mobilenetv3_small_arova_combined_binary.pth

# Whisper STT model: tiny | base | small | medium
WHISPER_MODEL=tiny

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Gradio server
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
GRADIO_SHARE=true
